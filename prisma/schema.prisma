// Prisma schema for the portfolio admin panel and CMS.
//
// Database: Neon `lakeview`, schema `sahan` ONLY. The CLI picks the schema from
// the connection string (`?schema=sahan`, see lib/db/url.ts) and the runtime
// picks it through the adapter option (see lib/db/prisma.ts). Other schemas in
// that database belong to other projects: never read, alter or drop them.
//
// Use `prisma db push` only. Never `migrate reset` or `--force-reset`.
// Design record: docs/plan/admin-cms-adr.md, section 7.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  DEVELOPER
  MANAGER
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum MediaProvider {
  LOCAL
  CLOUDINARY
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

enum MfaPurpose {
  SIGN_IN
  ENABLE
  DISABLE
}

enum TokenPurpose {
  INVITE
  PASSWORD_RESET
}

// ─── Access: users, roles, sessions, tokens ───────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  // Stored lowercase; the service layer normalises before every write.
  email              String    @unique
  name               String?
  passwordHash       String
  role               Role      @default(EDITOR)
  image              String?
  bio                String?   @db.Text
  mfaEnabled         Boolean   @default(false)
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime  @default(now())
  lastLoginAt        DateTime?
  disabledAt         DateTime?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions          UserSession[]
  mfaChallenges     MfaChallenge[]
  posts             Post[]
  auditLogs         AuditLog[]
  assignedInquiries Inquiry[]      @relation("InquiryAssignee")

  @@map("users")
}

// A row means the permission is granted to the role. DEVELOPER always holds
// every permission in code, so it needs no rows.
model RolePermission {
  role        Role
  permission  String
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@id([role, permission])
  @@map("role_permissions")
}

// One row per signed-in browser. `id` is the `sid` claim in the JWT. This table
// is authoritative for revocation; Redis only caches the state for 30 seconds.
model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip           String?
  userAgent    String?   @db.Text
  browser      String?
  os           String?
  device       String?
  mfaVerified  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  lastSeenAt   DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  revokedById  String?
  revokeReason String?

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

// Invite and password-reset links. Only the SHA-256 of the token is stored.
model AuthToken {
  id          String       @id @default(cuid())
  purpose     TokenPurpose
  email       String
  userId      String?
  // Role granted on acceptance (invites only).
  role        Role?
  tokenHash   String       @unique
  createdById String?
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("auth_tokens")
}

// Emailed one-time codes for sign-in, enabling and disabling MFA.
// `verifiedAt` is set when the right code is entered. `consumedAt` is set
// atomically when the sign-in (or the enable/disable action) uses the
// verified challenge, so one challenge can never open two sessions.
model MfaChallenge {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    MfaPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([userId, purpose, expiresAt])
  @@map("mfa_challenges")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  // Snapshot, so the trail survives deleting the user.
  actorEmail String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @db.Text
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Operational switches (maintenance, feature flags, allowlist). Editable by
// DEVELOPER only. Everything a visitor reads lives in ContentBlock instead.
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("settings")
}

// ─── CMS: versioned page sections ─────────────────────────────────────────────
// At most one DRAFT and one PUBLISHED row per (pageSlug, sectionSlug).

model ContentBlock {
  id            String        @id @default(cuid())
  pageSlug      String
  sectionSlug   String
  version       Int
  data          Json
  status        ContentStatus @default(DRAFT)
  note          String?
  createdById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([pageSlug, sectionSlug, version])
  @@index([pageSlug, sectionSlug, status])
  @@index([pageSlug, status])
  @@map("content_blocks")
}

// ─── Collections behind Home, About and Works ─────────────────────────────────
// Category, status, platform and link kind stay strings validated by zod so a
// new value is not a schema change.

model Project {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  tagline         String
  description     String   @db.Text
  role            String
  organization    String?
  organizationUrl String?
  category        String
  status          String
  platforms       String[] @default([])
  tech            String[] @default([])
  // { kind, url, label? }[]. The first entry is the primary action.
  links           Json     @default("[]")
  // { src, alt, fit?, background?, position?, mediaId? }
  image           Json?
  year            String
  featured        Boolean  @default(false)
  sortOrder       Int      @default(0)
  published       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortOrder])
  @@index([featured])
  @@map("projects")
}

model Experience {
  id         String   @id @default(cuid())
  company    String
  companyUrl String?
  role       String
  period     String
  type       String
  location   String?
  highlights String[] @default([])
  current    Boolean  @default(false)
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published, sortOrder])
  @@map("experiences")
}

model ServiceGroup {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  services  Service[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("service_groups")
}

model Service {
  id          String       @id @default(cuid())
  // Stable short key such as WEB or BCK.
  key         String       @unique
  groupId     String
  group       ServiceGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  iconKey     String
  name        String
  description String       @db.Text
  // { title, href?, list: { name, metric }[] }. `metric` describes how a count
  // is derived from projects, so counts are never stored.
  done        Json?
  sortOrder   Int          @default(0)
  published   Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([groupId, sortOrder])
  @@map("services")
}

model SkillGroup {
  id        String   @id @default(cuid())
  // SC1 to SC10 today.
  key       String   @unique
  label     String
  sortOrder Int      @default(0)
  skills    Skill[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skill_groups")
}

model Skill {
  id         String     @id @default(cuid())
  groupId    String
  group      SkillGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name       String
  abbr       String
  // Sub-group label shown inside a category, for example "frontend".
  type       String
  iconKey    String
  // "fill" or "stroke", which decides how the icon component is rendered.
  variant    String     @default("fill")
  colorLight String
  colorDark  String
  // { colors: [r, g, b], bgLight, bgDark } when the skill appears in the About
  // "Grid" layout, otherwise null.
  grid       Json?
  gridOrder  Int?
  sortOrder  Int        @default(0)
  published  Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([groupId, name])
  @@index([groupId, sortOrder])
  @@map("skills")
}

// ─── Updates (blog) ───────────────────────────────────────────────────────────

model Post {
  id             String      @id @default(cuid())
  slug           String      @unique
  title          String
  excerpt        String?     @db.Text
  // Editor HTML as saved by TipTap.
  content        String      @db.Text
  // Sanitized copy that the public site renders.
  contentHtml    String      @db.Text
  // Plain text for search and read time.
  contentText    String      @db.Text
  topic          String
  tags           String[]    @default([])
  status         PostStatus  @default(DRAFT)
  publishAt      DateTime?
  publishedAt    DateTime?
  coverMediaId   String?
  coverMedia     MediaAsset? @relation("PostCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  coverAlt       String?
  seoTitle       String?
  seoDescription String?     @db.Text
  canonicalUrl   String?
  readMinutes    Int         @default(1)
  generatedByAI  Boolean     @default(false)
  // Optional so deleting an author never fails on a foreign key.
  authorId       String?
  author         User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([status, publishedAt])
  @@index([status, publishAt])
  @@index([authorId])
  @@map("posts")
}

// ─── Media ────────────────────────────────────────────────────────────────────

model MediaAsset {
  id          String        @id @default(cuid())
  provider    MediaProvider @default(CLOUDINARY)
  kind        MediaKind     @default(IMAGE)
  // Absolute Cloudinary URL, or a /works/... path for LOCAL assets.
  url         String
  publicId    String?
  format      String
  width       Int?
  height      Int?
  sizeBytes   Int
  title       String?
  alt         String?
  tags        String[]      @default([])
  folder      String        @default("uncategorized")
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  usages     MediaUsage[]
  postCovers Post[]       @relation("PostCover")

  @@unique([provider, publicId])
  @@index([folder, createdAt])
  @@index([createdAt])
  @@map("media_assets")
}

// Where an asset is used. Maintained by the services on save and read by the
// "in use" warning before a delete.
model MediaUsage {
  id         String     @id @default(cuid())
  mediaId    String
  media      MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  field      String
  createdAt  DateTime   @default(now())

  @@unique([mediaId, entityType, entityId, field])
  @@index([entityType, entityId])
  @@map("media_usages")
}

// ─── Contact and leads ────────────────────────────────────────────────────────

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String?
  topic           String?
  message         String        @db.Text
  status          InquiryStatus @default(NEW)
  notes           String?       @db.Text
  assigneeId      String?
  assignee        User?         @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // "contact-form" or "chatbot".
  source          String        @default("contact-form")
  // HMAC of the visitor IP, never the address itself.
  ipHash          String?
  userAgent       String?       @db.Text
  pagePath        String?
  spamScore       Int           @default(0)
  // PENDING, SENT or FAILED.
  emailStatus     String        @default("PENDING")
  autoReplyStatus String        @default("PENDING")
  respondedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  events       InquiryEmailEvent[]
  chatSessions ChatSession[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([ipHash, createdAt])
  @@map("inquiries")
}

model InquiryEmailEvent {
  id        String   @id @default(cuid())
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  // "notify" or "auto-reply".
  kind      String
  provider  String
  ok        Boolean
  messageId String?
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@index([inquiryId])
  @@map("inquiry_email_events")
}

// ─── Chatbot ──────────────────────────────────────────────────────────────────

model ChatSession {
  id            String   @id @default(cuid())
  sessionId     String   @unique
  ipHash        String?
  userAgent     String?  @db.Text
  pagePath      String?
  inquiryId     String?
  inquiry       Inquiry? @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  messagesCount Int      @default(0)
  capturedLead  Boolean  @default(false)
  leadName      String?
  leadContact   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages ChatMessage[]

  @@index([createdAt])
  @@index([inquiryId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  role      String
  content   String      @db.Text
  tokens    Int?
  latencyMs Int?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model ChatTrainingEntry {
  id          String   @id @default(cuid())
  category    String   @default("FAQ")
  question    String   @db.Text
  answer      String   @db.Text
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, priority])
  @@map("chat_training_entries")
}
